[gd_resource type="Resource" script_class="Quest" load_steps=4 format=3]

[ext_resource type="Script" path="res://src/content/quest/quest.gd" id="1_quest"]
[ext_resource type="Script" path="res://src/content/quest/quest_step.gd" id="2_step"]

[sub_resource type="Resource" id="step_unlock"]
script = ExtResource("2_step")
step_id = &"unlock"
summary_key = "quest.keepers_errand.step.unlock"
condition_flag = &"area/courtyard/gate_unlocked"
condition_test = 1

[sub_resource type="Resource" id="step_dais"]
script = ExtResource("2_step")
step_id = &"dais"
summary_key = "quest.keepers_errand.step.dais"
condition_flag = &"area/courtyard/dais_entered"
condition_test = 1

[resource]
script = ExtResource("1_quest")
id = &"quest/keepers_errand"
name_key = "quest.keepers_errand.name"
summary_key = "quest.keepers_errand.summary"
steps = Array[QuestStep]([SubResource("step_unlock"), SubResource("step_dais")])
condition_flag = &"met/gardener"
condition_test = 1
